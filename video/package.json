{
  "name": "sobrevivencia-dark-video",
  "private": true,
  "version": "1.0.0",
  "description": "Episódios do canal Sobrevivência Dark feitos 100% em Remotion + Three.js (sem imagens de banco).",
  "scripts": {
    "estudio": "remotion studio",
    "sons": "node scripts/gerar-sons.mjs",
    "roteiro": "tsx scripts/gerar-roteiro.ts",
    "render": "remotion render Episodio01 out/episodio-01-alasca.mp4 --gl=angle --concurrency=1",
    "thumb": "remotion still Thumbnail out/thumbnail.png --gl=angle",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@remotion/cli": "4.0.541",
    "@remotion/noise": "4.0.541",
    "@remotion/three": "4.0.541",
    "@remotion/transitions": "4.0.541",
    "postprocessing": "^6.39.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "4.0.541",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
